  <data key="d7">chunk-c527f463c6b54a8cb919a64d12423b24</data>
  <data key="d8">1</data>
</edge>
<edge source="OLD GENTLEMAN" target="FREDERICK DENISON MAURICE">
  <data key="d5">0.7</data>
