{
  "model_name": "models/modernbert/answerdotai_ModernBERT-large",
  "output_dir": "training_data/models/modernbert_complexity_classifier",
  "label_mapping": {
    "zero_hop": 0,
    "one_hop": 1,
    "multi_hop": 2
  },
  "train_file": "training_data/processed/train_data.json",
  "val_file": "training_data/processed/val_data.json",
  "test_file": "training_data/processed/test_data.json",
  "text_field": "query",
  "label_field": "complexity",
  "max_length": 256,
  "batch_size": 4,
  "learning_rate": 1e-05,
  "num_epochs": 15,
  "warmup_ratio": 0.15,
  "weight_decay": 0.02,
  "gradient_accumulation_steps": 4,
  "use_lora": true,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.15,
  "seed": 42,
  "use_fp16": true,
  "logging_steps": 20,
  "eval_steps": 100,
  "save_steps": 100,
  "device": "cuda",
  "early_stopping_patience": 3,
  "early_stopping_threshold": 0.001,
  "eval_strategy": "steps",
  "save_strategy": "steps",
  "id2label": {
    "0": "zero_hop",
    "1": "one_hop",
    "2": "multi_hop"
  }
}