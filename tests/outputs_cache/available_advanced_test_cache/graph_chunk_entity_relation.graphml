  <data key="d3">chunk-403c2698466591d70033ff7077ada921</data>
</node>
<node id="QUAKERS' BURIAL GROUND">
  <data key="d0">QUAKERS' BURIAL GROUND</data>
  <data key="d1">LOCATION</data>
  <data key="d2">A place in Cornwall with a view considered one of the finest in the region. It is mentioned as a point of interest during the journey, though not visited directly by the travelers.</data>
  <data key="d3">chunk-403c2698466591d70033ff7077ada921</data>
</node>
<node id="THE NINE MAIDENS">
  <data key="d0">THE NINE MAIDENS</data>
  <data key="d1">LOCATION</data>
  <data key="d2">A circle of ancient stones in Cornwall, associated with the Druids. It is mentioned as an interesting site, though not explored by the travelers.</data>
  <data key="d3">chunk-403c2698466591d70033ff7077ada921</data>
</node>
<node id="THE GIRL">
